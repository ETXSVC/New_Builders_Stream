# Postgres superuser — used ONLY by Alembic migrations, never by the running app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=builders_stream

# App runtime connection — non-owner role created by migration 0001 (see design decision #1)
APP_DB_USER=app_user
APP_DB_PASSWORD=app_password

DATABASE_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/builders_stream
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5432/builders_stream
TEST_DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5432/builders_stream_test
# The `scanner` role (migration 0020): the connection the three daily
# cross-tenant sweeps in app/tasks/ use. BYPASSRLS so they can see every
# company, but owning nothing — unlike the table owner they used to
# connect as, it cannot drop a table or disable an RLS policy. Optional;
# unset falls back to MIGRATIONS_DATABASE_URL, which is an upgrade aid,
# not the intended steady state. The compose files set it for you.
SCANNER_DATABASE_URL=postgresql+asyncpg://scanner:scanner_password@localhost:5432/builders_stream
# scanner's password, assigned by migration 0020 at `alembic upgrade
# head` time. Its app_user counterpart is APP_DB_PASSWORD above, which
# 0020 now also applies — migration 0001 hard-codes `app_password` for
# that role, a publicly known value in a public repository. Set both in
# production BEFORE migrating; the config validator refuses to boot on a
# DATABASE_URL still carrying the default.
SCANNER_DB_PASSWORD=scanner_password

# The `platform_admin` role (migration 0023): the connection the
# cross-tenant platform console runs on. BYPASSRLS like `scanner` above,
# because listing every tenant is the whole job, but far narrower on
# writes — SELECT everywhere, DML on company_module_overrides, UPDATE on
# subscriptions, INSERT on audit_log, nothing else.
#
# Unlike SCANNER_DATABASE_URL there is NO fallback: leaving this unset
# disables the console (every /platform route 503s) rather than quietly
# running it on a wider connection. The compose files set it for you.
PLATFORM_DATABASE_URL=postgresql+asyncpg://platform_admin:platform_password@localhost:5432/builders_stream
# platform_admin's password, assigned by migration 0023 at `alembic
# upgrade head` time — same deal as SCANNER_DB_PASSWORD above. The
# `migrate` service reads it from THIS file, and `backend` builds its
# PLATFORM_DATABASE_URL from the same value, so the two only agree if it
# is set before the first migration run. Set it in production BEFORE
# migrating, or you ship a role whose password is a publicly known value
# in a public repository.
PLATFORM_DB_PASSWORD=platform_password

JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRE_MINUTES=15
# Platform-console sessions (migration 0023), separate from the tenant
# session above: this token reaches every tenant's subscription state and
# has no refresh-token flow behind it, so it expires sooner.
PLATFORM_JWT_EXPIRE_MINUTES=30

REDIS_URL=redis://redis:6379/0

# Task 4.3: Fernet key encrypting integration_connections' OAuth tokens at
# rest. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_TOKEN_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key=

# Local-filesystem root for Document uploads (Task 1.15, design decision #4).
# Matches the `documents_data` Docker volume mounted in docker-compose.yml;
# has a matching default in app/config.py so this line is optional.
STORAGE_ROOT=/data/documents

# Browser-facing origin of the Next.js app — the integrations OAuth callback
# 303-redirects here after a successful connect, and invitation emails link
# to {FRONTEND_BASE_URL}/accept-invitation. docker-compose maps the
# frontend to host port 3001 (app/config.py's default of :3000 suits
# `npm run dev` outside Docker).
FRONTEND_BASE_URL=http://localhost:3001

# Outbound email (invitation delivery). Leave SMTP_HOST unset to send
# nothing (a recording fake client is used — fine for dev/test). Setting it
# is the single switch that turns on real delivery via the worker.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=no-reply@yourdomain.com
# SMTP_STARTTLS=true

# Hostname note: DATABASE_URL uses the Docker-network hostname `postgres` because
# it's read by the `backend` container at runtime. MIGRATIONS_DATABASE_URL and
# TEST_DATABASE_URL use `localhost` because Alembic and pytest both run on the
# host, where only `localhost:5432` (published by docker-compose.yml) resolves.

# --- Production-only settings (docker-compose.prod.yml) ---------------------
# Full guide: docs/11-production-deployment.md. APP_ENV=production makes the
# backend REFUSE TO BOOT with any of this file's example secrets still in
# place, listing every violation at once.
# APP_ENV=production
# Domain Caddy serves + obtains a Let's Encrypt certificate for.
# SITE_ADDRESS=app.example.com
# Verifies POST /webhooks/stripe signatures (whichever client is selected
# below; still must be non-public in production). Generate: openssl rand -hex 32
# STRIPE_WEBHOOK_SECRET=
#
# --- Real Stripe billing -------------------------------------------------
# Unset (the default) means the in-memory FakeStripeClient: no Stripe
# account needed, no network calls, no money moves. Setting STRIPE_API_KEY
# is the single switch to the real SDK, and it is never inferred from
# anything else. Requires the backend's `stripe` extra: pip install '.[stripe]'
# STRIPE_API_KEY=sk_live_...
#
# One Stripe Price id per tier — the base line item on a new subscription.
# All three are REQUIRED once STRIPE_API_KEY is set; the process refuses to
# boot without them rather than failing at someone's first registration.
# STRIPE_PRICE_ID_STARTER=price_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_ENTERPRISE=price_...
#
# Per-unit Price for seats beyond the tier's included_seats. Optional —
# unset makes the nightly seat-overage job a no-op instead of an error.
# Must be a LICENSED per-unit Price, not a metered one: the job sets this
# item's quantity to the current overage every night, so metered (which
# accumulates) would bill roughly 30x. See report_seat_usage.
# STRIPE_SEAT_OVERAGE_PRICE_ID=price_...
#
# Where Stripe's hosted portal returns the user. Defaults to FRONTEND_BASE_URL.
# STRIPE_PORTAL_RETURN_URL=https://app.example.com/settings/billing
#
# --- Real accounting integrations ---------------------------------------
# Per-provider and independent: QuickBooks and FreshBooks are two OAuth
# applications with two separate approval processes, so one can go live
# while the other stays on the in-memory fake. Unset means the fake, which
# is what every local run, test and CI job uses.
#
# The OAuth redirect registered with each provider is derived from
# FRONTEND_BASE_URL as {base}/integrations/{provider}/callback and must
# match what you registered EXACTLY, or the code exchange is rejected.
# Override only if the backend's callback is reached on a different host:
# INTEGRATIONS_REDIRECT_BASE_URL=https://api.example.com
#
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# "sandbox" or "production". These are entirely separate datasets — the
# wrong one writes a live tenant's invoices where nobody will find them.
# QUICKBOOKS_ENVIRONMENT=production
#
# FRESHBOOKS_CLIENT_ID=
# FRESHBOOKS_CLIENT_SECRET=
# Scheduler cron timezone (02:00-04:00 daily jobs). Default UTC.
# TZ=America/Chicago
# Host directory the db-backup service writes dumps into. Default ./backups
# BACKUP_DIR=/opt/builders-stream-backups
# LOG_LEVEL=INFO

# Grafana's admin login (docs/06 §5's monitoring stack). REQUIRED by
# docker-compose.prod.yml — the stack refuses to come up without it, rather
# than starting on grafana's own admin/admin default and persisting a
# changed password into a volume nobody remembers. Generate:
#   openssl rand -base64 24
# Grafana, Prometheus and Alertmanager bind to 127.0.0.1 only; reach them
# over an SSH tunnel (docs/11-production-deployment.md §10), so this
# password guards against someone already on the box, not the internet.
# GRAFANA_ADMIN_PASSWORD=

# Error reporting (app/core/observability.py). UNSET = off: sentry-sdk is
# never imported and nothing leaves the box. Setting it turns reporting on
# for all three processes (api, worker, scheduler) at once.
#
# Requires the optional extra:  pip install -e ".[observability]"
# (the production image installs it; see backend/Dockerfile)
#
# Never sends PII — no emails, no names, and not the e-signature IP
# addresses docs/07 treats as legal evidence. It tags events with the
# VERIFIED company_id and role, which is what makes an alert say "this
# company is broken" rather than "500s are up".
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# Traces cost quota and errors are the stated need; raise deliberately.
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Upload caps (bytes) enforced by app/core/uploads.py; defaults 25 MiB
# documents / 1 MiB signature artifacts.
# MAX_DOCUMENT_UPLOAD_BYTES=26214400
# MAX_SIGNATURE_UPLOAD_BYTES=1048576
# Extra origins `next dev` should trust for its own internal endpoints
# (fonts, HMR socket), comma-separated. Only needed when you browse the dev
# stack by hostname rather than at localhost — without it those endpoints
# 403 for that origin while the app itself works, which reads like a broken
# build. Dev-only: `next build`/`next start` never read it.
# DEV_ALLOWED_ORIGINS=my-box:3001
