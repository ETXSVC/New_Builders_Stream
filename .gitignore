# OS / Office lock files
~$*
.DS_Store
Thumbs.db

# Claude Code local settings (machine-specific)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Editor
.vscode/

# Git worktrees (isolated implementation workspaces)
.worktrees/

# Local environment secrets (keep .env.example / .env.local.example trackable)
.env
.env*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
# setuptools' scratch dir — `pip install .` / `pip wheel .` (the non-editable
# path the production image builds through) leaves it behind.
build/
.venv/
.pytest_cache/
.coverage

# Node / Next.js
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Playwright e2e artifacts
frontend/test-results/
frontend/playwright-report/

# Redis local snapshot, created by `redis-server` during local/manual
# testing outside docker-compose (which runs Redis in its own container).
# Unanchored on purpose: this rule used to read `backend/dump.rdb`, which
# only covers a server started from that directory — one started from the
# repo root drops its dump beside this file and slipped straight past it.
# Pure runtime state (queued Dramatiq messages, rate-limit counters from
# test runs), never an input to anything.
dump.rdb

# Sandbox-only Playwright shim: pins executablePath at the Chromium build
# present in this dev container when it does not match the version
# @playwright/test expects. Machine-specific, never a CI input.
frontend/playwright.local.config.ts
