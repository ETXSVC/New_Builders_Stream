# API-side reverse proxy for the SPLIT topology (deploy/split/
# backend.compose.yml). Terminates TLS at api.<domain> in front of the
# FastAPI backend.
#
# Two load-bearing pieces:
#
# 1. remote_ip allowlist — the frontend server is the ONLY legitimate
#    caller of this API (the Next.js BFF proxies every product request
#    server-side; browsers never hit the API directly). Allowlisting its
#    IP preserves the single-box topology's "backend has no public
#    surface" property even when split across machines. Add Stripe's IP
#    ranges if/when real webhooks arrive alongside a /webhooks/stripe
#    route. (remote_ip matches the DIRECT TCP peer — exactly what we want
#    to pin here.)
#
# 2. Global trusted_proxies — WITHOUT it, Caddy would discard the
#    X-Forwarded-For the frontend BFF sets (carrying the real end-client
#    IP) and replace it with the frontend SERVER's address — silently
#    breaking the register rate limiter's per-client keying and, worse,
#    recording the wrong IP as ESIGN legal evidence. Trusting exactly the
#    frontend server's IP lets its (spoof-safe, Caddy-set) forwarded
#    chain pass through intact.

{
	servers {
		trusted_proxies static {$FRONTEND_SERVER_IP}
	}
}

{$API_ADDRESS} {
	encode gzip

	# HSTS, matching the sibling Caddyfile. The API is a separate origin
	# in the split topology and needs its own header — a browser that has
	# only ever pinned app.<domain> knows nothing about api.<domain>.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Same outer belt the sibling Caddyfile carries, and it was missing
	# here. In the split topology this proxy fronts the routes that
	# actually take uploads (project/compliance documents, signature
	# images) — so the file this cap most needs to stop reaches the
	# backend through THIS proxy, not through the frontend's. The
	# application-layer caps (app/core/uploads.py) remain the real
	# per-route limits; this only keeps a multi-gigabyte body from being
	# buffered before any of them get a say.
	request_body {
		max_size 30MB
	}

	@frontend remote_ip {$FRONTEND_SERVER_IP}
	handle @frontend {
		reverse_proxy backend:8000
	}
	# Anything not from the frontend server: flat 403, no detail.
	#
	# `handle` rather than a bare `respond`: a bare directive's position
	# in the evaluation order is decided by Caddy's own directive
	# ordering, not by where it sits in this file, so the 403 relied on
	# `handle` blocks being evaluated first — true today, but an
	# invariant expressed nowhere and silently breakable by a Caddy
	# upgrade or by anyone adding a directive above it. `handle` blocks
	# are mutually exclusive and evaluated in written order, which makes
	# "frontend gets the proxy, everyone else gets 403" explicit.
	handle {
		respond 403
	}
}
