{
  "uid": "builders-stream-overview",
  "title": "Builders Stream — Overview",
  "description": "The docs/06 §5 surface on one screen: service health, request rate/latency/errors by route template, Postgres pool saturation, Dramatiq queue and dead-letter depth, host CPU/memory/disk, per-container memory, and backup freshness. Provisioned read-only from deploy/grafana/dashboards — edit the file, not the browser.",
  "tags": ["builders-stream"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Service health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Scrape targets up",
      "description": "One tile per Prometheus target. A target dropping to 0 is what the ServiceDown alert fires on.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "up",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "up", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "API request rate by route",
      "description": "Route TEMPLATES, not raw paths — see app/core/metrics.py for why that distinction is load-bearing.",
      "gridPos": { "h": 6, "w": 10, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "sum by (route) (rate(buildersstream_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 8, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "5xx share of all requests",
      "description": "BackendErrorRateHigh alerts above 5%. docs/06 §1 sets the latency target; this is the correctness one.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "sum(rate(buildersstream_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(buildersstream_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          },
          "custom": { "fillOpacity": 10, "showPoints": "never", "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Request latency p95 by route",
      "description": "docs/06 §1 targets p95 < 300ms for non-report endpoints. The PDF export and bulk catalog import are the expected outliers.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(buildersstream_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 }
            ]
          },
          "custom": { "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] } }
    },
    {
      "type": "row",
      "id": 101,
      "title": "Saturation — pool and queues",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Postgres pool utilisation",
      "description": "A transaction is held open for the whole request (app/core/deps.py), so pool size is the concurrent-request ceiling. At 100% requests stall on checkout rather than erroring.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "buildersstream_db_pool_connections_in_use / buildersstream_db_pool_size",
          "legendFormat": "checked out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.9 }
            ]
          },
          "custom": { "fillOpacity": 12, "showPoints": "never", "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Dramatiq queue depth",
      "description": "`default` is work waiting for a worker; `default.DQ` is the delay queue — a growing .DQ means retries piling up, a different incident from workers falling behind.",
      "gridPos": { "h": 7, "w": 10, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "buildersstream_dramatiq_queue_depth",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 }
            ]
          },
          "custom": { "fillOpacity": 10, "showPoints": "never", "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Dead-lettered messages",
      "description": "Work that silently did not happen. `docker compose logs worker | grep dead-lettered` names the actor and its arguments.",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "sum(buildersstream_dramatiq_dead_letter_depth)",
          "legendFormat": "dead letters",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 102,
      "title": "Host and containers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Host CPU utilisation",
      "description": "1 minus the idle share, across all cores.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "cpu busy"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 12, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Host memory available",
      "description": "HostMemoryPressure alerts below 10%. The OOM killer picks its own victim, usually Postgres or the worker.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "available"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.1 }
            ]
          },
          "custom": { "fillOpacity": 12, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "bargauge",
      "id": 10,
      "title": "Disk used by mountpoint",
      "description": "docs/06 §5 alerts above 85%. Postgres data, uploads, 30 days of backups and Prometheus's own TSDB share this disk.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|fuse.*\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|fuse.*\"}",
          "legendFormat": "{{mountpoint}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.75 },
              { "color": "red", "value": 0.85 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Container memory",
      "description": "Per-container working set from cAdvisor — the 'container health' half of docs/06 §5 that node-exporter cannot see.",
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 8, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] } }
    },
    {
      "type": "stat",
      "id": 12,
      "title": "Since last successful backup",
      "description": "Written by deploy/backup/backup.sh into node-exporter's textfile collector. RPO is 24h (docs/06 §4); BackupStale alerts at 36h.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "builders-stream-prom" },
          "expr": "time() - buildersstream_backup_last_success_timestamp_seconds",
          "legendFormat": "age",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 90000 },
              { "color": "red", "value": 129600 }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
